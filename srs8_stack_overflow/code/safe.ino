// СРС №8 — безопасная итерационная версия: ограниченный цикл вместо рекурсии.
// Каждая итерация выполняется в одном и том же кадре setup(), поэтому
// расход стека остаётся приблизительно постоянным.

void setup() {
  Serial.begin(115200);
  delay(500);
  for (uint32_t i = 0; i <= 10000; i++) {
    if (i % 1000 == 0) {
      Serial.println(i);
    }
  }
  Serial.println("SAFE FINISH");
}

void loop() {}
